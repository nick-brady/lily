# Copy to .env and fill in. Compose reads this file automatically.

POSTGRES_DB=lily
POSTGRES_USER=lily
POSTGRES_PASSWORD=change-me

JWT_SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
# The backend publishes no host port: the browser talks to it same-origin
# through the frontend's /api dev proxy (vite.config.js).

# Optional seed identities for `scripts/migrate_to_multitenant.py`.
# Defaults: nick@example.com / alexis@example.com — override before
# running the migration if you want the real auth flow to land on you.
SEED_OWNER_EMAIL=
SEED_OWNER_PHONE=
SEED_OWNER_NAME=
SEED_COPARENT_EMAIL=
SEED_COPARENT_PHONE=
SEED_COPARENT_NAME=

# S3 / MinIO (dev). In production leave AWS_ENDPOINT_URL unset and use IAM creds.
S3_BUCKET=lily-media
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_REGION=us-east-1
# Browser-facing MinIO URL for presigned redirects (dev only).
AWS_PUBLIC_ENDPOINT_URL=http://localhost:9000

# Printful fulfillment (gift mockups). Leave PRINTFUL_API_KEY unset to disable
# — the gift gallery then just shows the flat artwork. When set, the backend
# renders each design onto the real product via Printful's Mockup Generator.
# The products offered live in code (backend/fulfillment/products.py).
# NOTE: Printful fetches the artwork by URL, so it must be publicly reachable
# (real S3 in prod — dev MinIO on localhost won't work).
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=

# Message delivery. Each channel goes live when its vars are set and falls
# back to printing to the backend log otherwise
# (docker compose logs backend | grep Code). Sign-in codes are EMAIL-ONLY
# (identity is email); Twilio carries invites, the birth-alerts opt-in
# confirmation, and birth-event texts — nothing else, ever. RESEND_FROM
# defaults to Resend's sandbox sender until you verify a domain.
# NOTE: sending SMS in production needs A2P 10DLC campaign registration —
# start it early, carrier approval takes weeks.
RESEND_API_KEY=
RESEND_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# "Continue with Google" (optional). One OAuth web client id used by both
# sides: backend verifies the ID token audience, frontend renders the
# button (Vite exposes VITE_* to the browser). Both empty = button hidden,
# email codes still work.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Stripe — payments (gifts). Prefer a RESTRICTED key (rk_...) over
# a secret key: Dashboard → API keys → Create restricted key, with only
# "Checkout Sessions: write" and "Refunds: write" — least privilege limits
# the blast radius if the key leaks. Test keys: rk_test_/sk_test_. Unset keys make
# the gift CTA fall back gracefully (503). Webhooks in dev:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# and put the printed whsec_... here. Without the CLI, the redirect-return
# confirm path still fulfills paid sessions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gift fulfillment. Printful orders are created as DRAFTS (you approve them
# in the Printful dashboard) until PRINTFUL_CONFIRM_ORDERS=true. Shipping
# countries offered at checkout (comma-separated ISO codes).
PRINTFUL_CONFIRM_ORDERS=
GIFT_SHIPPING_COUNTRIES=US

# Admin dashboard allowlist (comma-separated emails for /admin/* endpoints)
ADMIN_EMAILS=

# Logging. LOG_DIR gets one JSON-lines file per process (web.jsonl,
# worker.jsonl); unset means stderr only. LOG_TO_DB=0 keeps records out of
# the app_logs table the admin site reads (the unit tests set this).
# LOG_DIR=/app/logs
# LOG_LEVEL=INFO
# LOG_TO_DB=1

# Set automatically by scripts/dev-tunnel.sh while it runs. Where Printful
# fetches artwork from to generate mockups — it can't reach localhost. Leave
# unset in prod (falls back to FRONTEND_URL).
# ARTWORK_PUBLIC_URL=
