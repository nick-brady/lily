# Copy to .env and fill in. Compose reads this file automatically.

POSTGRES_DB=lily
POSTGRES_USER=lily
POSTGRES_PASSWORD=change-me

JWT_SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000

# Optional seed identities for `scripts/migrate_to_multitenant.py`.
# Defaults: nick@example.com / alexis@example.com — override before
# running the migration if you want the real auth flow to land on you.
SEED_OWNER_EMAIL=
SEED_OWNER_PHONE=
SEED_OWNER_NAME=
SEED_COPARENT_EMAIL=
SEED_COPARENT_PHONE=
SEED_COPARENT_NAME=

# S3 / MinIO (dev). In production leave AWS_ENDPOINT_URL unset and use IAM creds.
S3_BUCKET=lily-media
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_REGION=us-east-1
# Browser-facing MinIO URL for presigned redirects (dev only).
AWS_PUBLIC_ENDPOINT_URL=http://localhost:9000
