---
# Copy to secrets.yml (gitignored) and fill in. Rendered into
# /opt/lily/backend/.env (0600) by the app role.

db_password: "change-me-long-random"
jwt_secret_key: "change-me-long-random"     # e.g. `openssl rand -hex 32`

# Stripe — use a RESTRICTED key (rk_...) with only Checkout Sessions: write
# + Refunds: write. Test keys first; the webhook secret comes from the
# dashboard webhook endpoint (created post-deploy).
stripe_secret_key: ""
stripe_webhook_secret: ""

# Auth-code delivery (channels fall back to console codes in journald when unset)
resend_api_key: ""
resend_from: ""                              # "Arrival Story <hello@arrivalstory.com>" once verified
twilio_account_sid: ""
twilio_auth_token: ""
twilio_from: ""

# Gift fulfillment (orders stay Printful DRAFTS unless printful_confirm_orders: "true")
printful_api_key: ""
printful_store_id: ""
printful_confirm_orders: ""
gift_shipping_countries: "US"

# Admin dashboard allowlist — comma-separated emails allowed to call
# /admin/* endpoints (server-side check; there is no is_admin column).
admin_emails: "you@example.com"
