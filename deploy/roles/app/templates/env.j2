# Rendered by Ansible (deploy/roles/app/templates/env.j2) — do not edit on
# the box; change deploy/group_vars/secrets.yml and re-run deploy-code.yml.
DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@localhost:5432/{{ db_name }}
JWT_SECRET_KEY={{ jwt_secret_key }}
FRONTEND_URL=https://{{ app_domain }}
CORS_ALLOW_ORIGINS=https://{{ app_domain }}

# Admin dashboard (admin vhost proxies /api same-origin, so no CORS entry).
ADMIN_EMAILS={{ admin_emails }}

# S3 via the instance IAM role — deliberately no AWS keys here.
S3_BUCKET={{ s3_bucket }}
AWS_REGION={{ aws_region }}

STRIPE_SECRET_KEY={{ stripe_secret_key }}
STRIPE_WEBHOOK_SECRET={{ stripe_webhook_secret }}

RESEND_API_KEY={{ resend_api_key }}
RESEND_FROM={{ resend_from }}
TWILIO_ACCOUNT_SID={{ twilio_account_sid }}
TWILIO_AUTH_TOKEN={{ twilio_auth_token }}
TWILIO_FROM={{ twilio_from }}

# "Continue with Google" — backend verifies the ID-token audience.
GOOGLE_CLIENT_ID={{ google_client_id }}

PRINTFUL_API_KEY={{ printful_api_key }}
PRINTFUL_STORE_ID={{ printful_store_id }}
PRINTFUL_CONFIRM_ORDERS={{ printful_confirm_orders }}
GIFT_SHIPPING_COUNTRIES={{ gift_shipping_countries }}

GIFT_RENDER_TZ={{ gift_render_tz }}
