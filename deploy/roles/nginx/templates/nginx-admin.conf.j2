# Arrival Story admin dashboard — a separate SPA on its own subdomain,
# same local backend. The /api proxy is duplicated here on purpose: the
# admin app stays same-origin with the API, so CORS_ALLOW_ORIGINS never
# needs the admin domain. TLS gating works exactly like nginx.conf.j2
# (tls_enabled is derived from a stat of this domain's own certificate).
#
# No basic-auth / IP allowlist layer by choice — authorization is the
# server-side ADMIN_EMAILS check on every /admin/* endpoint.

{% if tls_enabled | bool %}
server {
    listen 80;
    server_name {{ admin_domain }};
    return 301 https://$host$request_uri;
}
{% endif %}

server {
{% if tls_enabled | bool %}
    listen 443 ssl http2;
    ssl_certificate /etc/letsencrypt/live/{{ admin_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ admin_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
{% else %}
    listen 80;
{% endif %}
    server_name {{ admin_domain }};

    root {{ app_dir }}/frontend-admin;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass http://127.0.0.1:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # hashed build assets are immutable
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
