# Lily — single-instance production.
# nginx serves the built SPA and proxies /api/* to the local uvicorn,
# stripping the prefix (identical to the vite dev proxy, so dev == prod).
# The /api prefix is load-bearing: /b/{slug} is BOTH an SPA route and an
# API route — bare same-origin paths could never be proxied safely.
#
# TLS is rendered by THIS template (tls_enabled), not layered on by
# certbot — `certbot certonly` only issues the certificate. That keeps
# playbook re-runs idempotent: a re-rendered config never loses :443.

{% if tls_enabled | bool %}
server {
    listen 80;
    server_name {{ app_domain }};
    return 301 https://$host$request_uri;
}
{% endif %}

server {
{% if tls_enabled | bool %}
    listen 443 ssl http2;
    ssl_certificate /etc/letsencrypt/live/{{ app_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ app_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
{% else %}
    listen 80;
{% endif %}
    server_name {{ app_domain }};

    root {{ app_dir }}/frontend;
    index index.html;

    # phone videos per the product spec
    client_max_body_size 200m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # /api/track is a public unauthenticated INSERT (self-hosted analytics,
    # no IPs stored app-side) — rate-limit it here, where the IP is visible.
    # The zone lives in conf.d/lily-ratelimit.conf (http scope).
    location = /api/track {
        limit_req zone=track burst=20 nodelay;
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass http://127.0.0.1:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    location /api/ {
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass http://127.0.0.1:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE (the live birth timeline) streams under /api — never buffer it
        # and never time it out mid-labor.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        proxy_set_header Connection "";
    }

    # hashed build assets are immutable
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Self-hosted web fonts (scripts/vendor-fonts.sh). Cached hard but not
    # `immutable`: their names say family/weight/style/subset rather than a
    # content hash, so a re-vendored file reuses its name and must be able to
    # win a revalidation rather than sit stale in caches for a year.
    location /fonts/ {
        expires 30d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # A family's page and the tooling around it are never for an index —
    # said here as a header, and again as a meta tag by the app, so a leaked
    # link stays out of search results either way.
    #
    # `rewrite … break`, not `try_files … /index.html`: try_files' fallback is
    # an internal redirect into `location /`, and add_header belongs to the
    # location that finally answers — so the header was being lost. Nothing
    # under these paths is a real file, so serving the shell directly is right.
    location ~ ^/(b|invite|account|setup|login)(/|$) {
        add_header X-Robots-Tag "noindex, nofollow" always;
        rewrite ^ /app.html break;
    }

    # The public pages are pre-rendered at build time into index.html,
    # pricing/index.html and friends (frontend/scripts/prerender.mjs).
    # Everything else falls back to app.html, the untouched SPA shell — not
    # index.html, which is now the home page's markup.
    location / {
        try_files $uri $uri/index.html /app.html;
    }
}
