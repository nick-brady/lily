<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     width="{{ w }}" height="{{ h }}" viewBox="0 0 {{ w }} {{ h }}">
{% from "_clock.svg.j2" import clock with context %}
  {# The photo used to sit in the middle of the clock face, which cost the
     dial its inner radius — the space the day rings now need. It moves down
     beside the name, where it reads as a portrait rather than a hole in the
     artwork, and the face gets its centre back. #}
  {% set photo_r = 150 %}
  {% set photo_cx = 320 %}
  {% set photo_cy = 1700 %}
  <defs>
    <clipPath id="namePhoto">
      <circle cx="{{ photo_cx }}" cy="{{ photo_cy }}" r="{{ photo_r }}"/>
    </clipPath>
  </defs>

  <rect x="0" y="0" width="{{ w }}" height="{{ h }}" fill="{{ p.bg }}"/>

  <!-- eyebrow -->
  <text x="{{ w // 2 }}" y="280" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="36" font-weight="500" letter-spacing="14"
        fill="{{ p.accent }}">THE HOURS BEFORE {{ child_name|upper }}</text>

  <!-- the labor clock -->
  {{ clock() }}

  <!-- her, beside her name -->
  {% if photo_data_uri %}
  <g clip-path="url(#namePhoto)">
    <image x="{{ photo_cx - photo_r }}" y="{{ photo_cy - photo_r }}"
           width="{{ photo_r * 2 }}" height="{{ photo_r * 2 }}"
           preserveAspectRatio="xMidYMid slice"
           xlink:href="{{ photo_data_uri }}"/>
  </g>
  <circle cx="{{ photo_cx }}" cy="{{ photo_cy }}" r="{{ photo_r + 12 }}"
          fill="none" stroke="{{ p.ink }}" stroke-width="2" opacity="0.3"/>
  {% endif %}

  {# Name and date sit beside the photo — or centred on the card when the
     photo has been removed, which is where they lived before it moved down
     here. Nothing should look like it's making room for something absent. #}
  {% set text_x = photo_data_uri and (photo_cx + photo_r + 90) or (w // 2) %}
  {% set text_anchor = photo_data_uri and 'start' or 'middle' %}
  <text x="{{ text_x }}" y="1690" text-anchor="{{ text_anchor }}"
        font-family="{{ p.display_font }}"
        font-size="175" font-weight="300" font-style="italic"
        fill="{{ p.ink }}">{{ child_name }}</text>
  <text x="{{ photo_data_uri and (text_x + 6) or text_x }}" y="1790"
        text-anchor="{{ text_anchor }}" font-family="{{ p.body_font }}"
        font-size="38" letter-spacing="2" fill="{{ p.ink }}"
        opacity="0.62">born {{ birth_date }} at {{ birth_time }}</text>

  <!-- footer -->
  <line x1="{{ w // 2 - 80 }}" y1="1895" x2="{{ w // 2 + 80 }}" y2="1895"
        stroke="{{ p.ink }}" stroke-width="2" opacity="0.25"/>
  <text x="{{ w // 2 }}" y="1975" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="30" letter-spacing="6" fill="{{ p.ink }}"
        opacity="0.5">{{ count }} CONTRACTIONS · {{ labor_duration|upper }} OF LABOR · EVERY {{ avg_interval|upper }}</text>
</svg>
