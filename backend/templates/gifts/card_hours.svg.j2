<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     width="{{ w }}" height="{{ h }}" viewBox="0 0 {{ w }} {{ h }}">
  <rect x="0" y="0" width="{{ w }}" height="{{ h }}" fill="{{ p.bg }}"/>

  <!-- eyebrow -->
  <text x="{{ w // 2 }}" y="280" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="36" font-weight="500" letter-spacing="14"
        fill="{{ p.accent }}">THE HOURS BEFORE {{ child_name|upper }}</text>

  <!-- the labor clock -->
  {% for t in clock_ticks %}
  <line x1="{{ t.x1 }}" y1="{{ t.y1 }}" x2="{{ t.x2 }}" y2="{{ t.y2 }}"
        stroke="{{ p.ink }}" stroke-width="{{ 3 if t.hour else 1.6 }}"
        opacity="{{ 0.38 if t.hour else 0.16 }}"/>
  {% endfor %}
  {% for s in clock_strokes %}
  <line x1="{{ s.x1 }}" y1="{{ s.y1 }}" x2="{{ s.x2 }}" y2="{{ s.y2 }}"
        stroke="{{ p.accent }}" stroke-width="4.5" stroke-linecap="round"
        opacity="{{ s.o }}"/>
  {% endfor %}
  {% if clock_start_dot %}
  <circle cx="{{ clock_start_dot.x }}" cy="{{ clock_start_dot.y }}" r="9"
          fill="{{ p.dot }}"/>
  {% endif %}
  {% if clock_star %}
  <path d="{{ clock_star }}" fill="{{ p.accent }}"/>
  {% endif %}
  {% if clock_star_label %}
  <text x="{{ clock_star_label.x }}" y="{{ clock_star_label.y }}" text-anchor="middle"
        font-family="{{ p.body_font }}" font-size="30" letter-spacing="3"
        fill="{{ p.ink }}" opacity="0.55">{{ birth_time }}</text>
  {% endif %}
  {% if clock_start_label and labor_start_time %}
  <text x="{{ clock_start_label.x }}" y="{{ clock_start_label.y }}" text-anchor="middle"
        font-family="{{ p.body_font }}" font-size="30" letter-spacing="3"
        fill="{{ p.ink }}" opacity="0.55">{{ labor_start_time }}</text>
  {% endif %}

  <!-- name + date -->
  <text x="{{ w // 2 }}" y="1690" text-anchor="middle"
        font-family="{{ p.display_font }}" font-size="195" font-weight="300"
        font-style="italic" fill="{{ p.ink }}">{{ child_name }}</text>
  <text x="{{ w // 2 }}" y="1795" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="38" letter-spacing="2" fill="{{ p.ink }}" opacity="0.62">born {{ birth_date }} at {{ birth_time }}</text>

  <!-- footer -->
  <line x1="{{ w // 2 - 80 }}" y1="1895" x2="{{ w // 2 + 80 }}" y2="1895"
        stroke="{{ p.ink }}" stroke-width="2" opacity="0.25"/>
  <text x="{{ w // 2 }}" y="1975" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="30" letter-spacing="6" fill="{{ p.ink }}"
        opacity="0.5">{{ count }} CONTRACTIONS · {{ labor_duration|upper }} OF LABOR · EVERY {{ avg_interval|upper }}</text>
</svg>
