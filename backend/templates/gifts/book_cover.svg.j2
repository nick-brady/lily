<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     width="{{ w }}" height="{{ h }}" viewBox="0 0 {{ w }} {{ h }}">
{% from "_clock.svg.j2" import clock with context %}
{# The wrap: back | spine | front, with bleed. The clock and the name on the
   front, the name along the spine, a heart and the numbers on the back. #}
  <rect x="0" y="0" width="{{ w }}" height="{{ h }}" fill="{{ p.bg }}"/>
  {{ clock(label_size=30) }}
  <text x="{{ book_front_cx }}" y="2050" text-anchor="middle" font-family="{{ p.display_font }}"
        font-size="{{ [child_name_size, 200]|min }}" font-weight="300" font-style="italic"
        fill="{{ p.ink }}">{{ child_name }}</text>
  <text x="{{ book_front_cx }}" y="2150" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="40" letter-spacing="3" fill="{{ p.ink }}" opacity="0.62">born {{ birth_date }} at {{ birth_time }}</text>
  <text x="{{ book_front_cx }}" y="{{ h - 330 }}" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="34" letter-spacing="12" fill="{{ p.accent }}">THE DAY</text>
  <text x="{{ book_spine_cx }}" y="{{ h // 2 }}" text-anchor="middle" dominant-baseline="middle"
        transform="rotate(90 {{ book_spine_cx }} {{ h // 2 }})"
        font-family="{{ p.display_font }}" font-size="{{ book_spine_size }}" font-style="italic"
        fill="{{ p.ink }}">{{ child_name }} · {{ book_year }}</text>
  <path d="{{ book_back_heart }}" fill="none" stroke="{{ p.accent }}" stroke-width="5"
        stroke-linejoin="round" opacity="0.9"/>
  <text x="{{ book_back_cx }}" y="{{ h // 2 + 160 }}" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="34" letter-spacing="6" fill="{{ p.ink }}"
        opacity="0.5">{{ count }} CONTRACTIONS TIMED{% if labor_start_time %} · FIRST AT {{ labor_start_time|upper }}{% endif %}</text>
  <text x="{{ book_back_cx }}" y="{{ h - 330 }}" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="26" letter-spacing="8" fill="{{ p.ink }}" opacity="0.4">ARRIVAL STORY</text>
</svg>
