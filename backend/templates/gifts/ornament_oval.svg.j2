<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     width="{{ w }}" height="{{ h }}" viewBox="0 0 {{ w }} {{ h }}">
{% from "_clock.svg.j2" import clock with context %}
{# A wooden oval ornament, 3.9 × 6.3 in at 150 DPI, printed straight onto the
   wood — so no page colour: the grain is the ground. The die-cut oval fills
   the sheet with a hanging hole at the top; everything sits inside its safe
   ellipse and below the hole. The labor clock, small, then her name and the
   day she arrived — the first tree she'll see. #}
  {{ clock(label_size=14, marks=False, day_labels=False, ink=2.4) }}
  {# the fitted size, but never larger than the ornament can carry #}
  <text x="{{ w // 2 }}" y="676" text-anchor="middle" font-family="{{ p.display_font }}"
        font-size="{{ [child_name_size, 66]|min }}" font-weight="300" font-style="italic"
        fill="{{ p.ink }}">{{ child_name }}</text>
  <text x="{{ w // 2 }}" y="716" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="17" letter-spacing="2" fill="{{ p.ink }}"
        opacity="0.95">born {{ birth_date }}</text>
  {% if custom_line %}
  <text x="{{ w // 2 }}" y="766" text-anchor="middle" font-family="{{ p.display_font }}"
        font-size="{{ [custom_line_size, 30]|min }}" font-style="italic" fill="{{ p.ink }}"
        opacity="0.95">{{ custom_line }}</text>
  {% endif %}
</svg>
