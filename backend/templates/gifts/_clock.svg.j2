{# The labor clock face, shared by every clock-family template. Import
   `with context` so the macro reads the scene geometry (clock_ticks,
   clock_strokes, …) and palette straight from the render context. #}
{% macro clock(label_size=30) %}
  {% for t in clock_ticks %}
  <line x1="{{ t.x1 }}" y1="{{ t.y1 }}" x2="{{ t.x2 }}" y2="{{ t.y2 }}"
        stroke="{{ p.ink }}" stroke-width="{{ 3 if t.hour else 1.6 }}"
        opacity="{{ 0.38 if t.hour else 0.16 }}"/>
  {% endfor %}
  {% for s in clock_strokes %}
  <line x1="{{ s.x1 }}" y1="{{ s.y1 }}" x2="{{ s.x2 }}" y2="{{ s.y2 }}"
        stroke="{{ p.accent }}" stroke-width="4.5" stroke-linecap="round"
        opacity="{{ s.o }}"/>
  {% endfor %}
  {% if clock_start_dot %}
  <circle cx="{{ clock_start_dot.x }}" cy="{{ clock_start_dot.y }}" r="9"
          fill="{{ p.dot }}"/>
  {% endif %}
  {% if clock_star %}
  <path d="{{ clock_star }}" fill="{{ p.accent }}"/>
  {% endif %}
  {% if clock_star_label %}
  <text x="{{ clock_star_label.x }}" y="{{ clock_star_label.y }}" text-anchor="middle"
        font-family="{{ p.body_font }}" font-size="{{ label_size }}" letter-spacing="3"
        fill="{{ p.ink }}" opacity="0.55">{{ birth_time }}</text>
  {% endif %}
  {% if clock_start_label and labor_start_time %}
  <text x="{{ clock_start_label.x }}" y="{{ clock_start_label.y }}" text-anchor="middle"
        font-family="{{ p.body_font }}" font-size="{{ label_size }}" letter-spacing="3"
        fill="{{ p.ink }}" opacity="0.55">{{ labor_start_time }}</text>
  {% endif %}
{% endmacro %}
