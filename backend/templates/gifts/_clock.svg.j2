{# The labor clock face, shared by every clock-family template. Import
   `with context` so the macro reads the scene geometry (clock_rings,
   clock_ticks, …) and palette straight from the render context.

   One 12-hour dial, and a concentric ring per day of labor. Each ring's
   grey circle is the ground its rays stand on and the line its milestone
   marks ride — so a mark sits on the day it happened, inside the face,
   instead of floating outside it. #}
{% macro clock(label_size=30) %}
  {% for t in clock_ticks %}
  <line x1="{{ t.x1 }}" y1="{{ t.y1 }}" x2="{{ t.x2 }}" y2="{{ t.y2 }}"
        stroke="{{ p.ink }}" stroke-width="{{ 3 if t.hour else 1.6 }}"
        opacity="{{ 0.38 if t.hour else 0.16 }}"/>
  {% endfor %}

  {# it wasn't obvious this was a clock, which left every angle on it
     meaningless to whoever was holding it #}
  {% for n in clock_numerals %}
  <text x="{{ n.x }}" y="{{ n.y }}" text-anchor="middle"
        font-family="{{ p.body_font }}" font-size="{{ label_size + 4 }}"
        letter-spacing="2" fill="{{ p.ink }}" opacity="0.42">{{ n.t }}</text>
  {% endfor %}

  {% for ring in clock_rings %}
  <circle cx="{{ clock_cx }}" cy="{{ clock_cy }}" r="{{ ring.base }}" fill="none"
          stroke="{{ p.ink }}" stroke-width="1.4" opacity="0.13"/>
  {% endfor %}

  {# AM pale and fine, PM deep and heavy — three cues at once, because the
     two theme tones are close enough that hue alone couldn't carry it #}
  {% for ring in clock_rings %}
  {% for s in ring.strokes %}
  <line x1="{{ s.x1 }}" y1="{{ s.y1 }}" x2="{{ s.x2 }}" y2="{{ s.y2 }}"
        stroke="{{ p.dot if s.am else p.accent }}" stroke-width="{{ s.w }}"
        stroke-linecap="round" opacity="{{ s.o }}"/>
  {% endfor %}
  {% endfor %}

  {% if clock_day_labels %}
  {% for ring in clock_rings %}
  <rect x="{{ clock_cx - 62 }}" y="{{ clock_cy + ring.base - 19 }}"
        width="124" height="34" rx="17" fill="{{ p.bg }}" opacity="0.92"/>
  <text x="{{ clock_cx }}" y="{{ clock_cy + ring.base + 4 }}" text-anchor="middle"
        font-family="{{ p.body_font }}" font-size="{{ label_size - 9 }}"
        letter-spacing="3" fill="{{ p.ink }}" opacity="0.55">{{ ring.label }}</text>
  {% endfor %}
  {% endif %}

  {# the marks: a ground of page colour so each reads clear of the rays it
     crosses, then the mark itself. Hand-drawn ones are stroked; imported
     icons carry their own outline and bring their own transform. #}
  {% for m in clock_marks + ([clock_born_mark] if clock_born_mark else []) %}
  <circle cx="{{ m.x }}" cy="{{ m.y }}" r="{{ m.halo }}"
          fill="{{ p.bg }}" opacity="0.9"/>
  {% if m.transform %}
  <g transform="{{ m.transform }}">
    <path d="{{ m.d }}" fill="{{ p.accent }}" fill-rule="{{ m.rule }}" opacity="0.85"/>
  </g>
  {% else %}
  <path d="{{ m.d }}" fill="none" stroke="{{ p.accent }}" stroke-width="{{ m.stroke }}"
        stroke-linejoin="round" stroke-linecap="round" opacity="0.9"/>
  {% endif %}
  {% endfor %}
{% endmacro %}

{# What the two tones mean. Drawn here so every template agrees on how it
   looks; placed by each template so it sits with that design's own text —
   under the parent's line on the mug, under the footer on the cards. Renders
   nothing when the dial is one-toned. #}
{% macro legend(x, y, anchor='start') %}
  {% if clock_legend %}
  {% set x0 = (x - 112) if anchor == 'middle' else x %}
  <line x1="{{ x0 }}" y1="{{ y }}" x2="{{ x0 + 38 }}" y2="{{ y }}"
        stroke="{{ p.dot }}" stroke-width="{{ clock_legend.am_w }}"
        stroke-linecap="round" opacity="{{ clock_legend.am_o }}"/>
  <text x="{{ x0 + 50 }}" y="{{ y + 9 }}" font-family="{{ p.body_font }}"
        font-size="26" letter-spacing="4" fill="{{ p.ink }}" opacity="0.5">AM</text>
  <line x1="{{ x0 + 132 }}" y1="{{ y }}" x2="{{ x0 + 170 }}" y2="{{ y }}"
        stroke="{{ p.accent }}" stroke-width="{{ clock_legend.pm_w }}"
        stroke-linecap="round" opacity="{{ clock_legend.pm_o }}"/>
  <text x="{{ x0 + 182 }}" y="{{ y + 9 }}" font-family="{{ p.body_font }}"
        font-size="26" letter-spacing="4" fill="{{ p.ink }}" opacity="0.5">PM</text>
  {% endif %}
{% endmacro %}
