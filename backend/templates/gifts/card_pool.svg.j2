<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     width="{{ w }}" height="{{ h }}" viewBox="0 0 {{ w }} {{ h }}">
{% from "_pool.svg.j2" import pool_list, pool_ruler_strip with context %}
  <rect x="0" y="0" width="{{ w }}" height="{{ h }}" fill="{{ p.bg }}"/>

  <!-- title -->
  <text x="{{ w // 2 }}" y="170" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="34" font-weight="500" letter-spacing="14"
        fill="{{ p.accent }}">THE FAMILY POOL</text>
  <text x="{{ w // 2 }}" y="330" text-anchor="middle"
        font-family="{{ p.display_font }}" font-size="150" font-weight="300"
        font-style="italic" fill="{{ p.ink }}">{{ child_name }}</text>
  <text x="{{ w // 2 }}" y="415" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="34" letter-spacing="2" fill="{{ p.ink }}"
        opacity="0.62">born {{ birth_date }} at {{ birth_time }}</text>
  <text x="{{ w // 2 }}" y="530" text-anchor="middle"
        font-family="{{ p.display_font }}" font-size="52" font-style="italic"
        fill="{{ p.ink }}" opacity="0.7">everyone guessed before they met you</text>

  <!-- the leaderboard -->
  {{ pool_list() }}

  <!-- the ruler -->
  {{ pool_ruler_strip() }}

  <!-- footer -->
  <text x="{{ w // 2 }}" y="2040" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="28" letter-spacing="6" fill="{{ p.ink }}"
        opacity="0.5">{{ pool_count }} GUESSES{% if pool_winner %} · CLOSEST: {{ pool_winner|upper }}{% endif %}{% if pool_extra %} · +{{ pool_extra }} MORE{% endif %}</text>
</svg>
