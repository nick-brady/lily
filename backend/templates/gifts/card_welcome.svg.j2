<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
     width="{{ w }}" height="{{ h }}" viewBox="0 0 {{ w }} {{ h }}">
  <defs>
    <clipPath id="heroRect">
      <rect x="110" y="110" width="{{ w - 220 }}" height="1100"/>
    </clipPath>
    <linearGradient id="horizonFade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="{{ p.accent }}" stop-opacity="0.20"/>
      <stop offset="1" stop-color="{{ p.accent }}" stop-opacity="0"/>
    </linearGradient>
  </defs>

  <rect x="0" y="0" width="{{ w }}" height="{{ h }}" fill="{{ p.bg }}"/>

  <!-- hero photo with a fine keyline mat -->
  {% if photo_data_uri %}
  <g clip-path="url(#heroRect)">
    <image x="110" y="110" width="{{ w - 220 }}" height="1100"
           preserveAspectRatio="xMidYMid slice"
           xlink:href="{{ photo_data_uri }}"/>
  </g>
  {% endif %}
  <rect x="94" y="94" width="{{ w - 188 }}" height="1132" fill="none"
        stroke="{{ p.ink }}" stroke-width="2" opacity="0.25"/>

  <!-- announcement -->
  <text x="{{ w // 2 }}" y="1390" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="36" font-weight="500" letter-spacing="14"
        fill="{{ p.accent }}">WELCOME TO THE WORLD</text>
  <text x="{{ w // 2 }}" y="1585" text-anchor="middle"
        font-family="{{ p.display_font }}" font-size="200" font-weight="300"
        font-style="italic" fill="{{ p.ink }}">{{ child_name }}</text>
  <text x="{{ w // 2 }}" y="1690" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="38" letter-spacing="2" fill="{{ p.ink }}"
        opacity="0.62">{{ birth_date }} · {{ birth_time }}</text>

  <!-- the labor horizon -->
  {% if has_sparkline %}
  {% set hx, hy, hw, hh = 330, 1770, 840, 180 %}
  <svg x="{{ hx }}" y="{{ hy }}" width="{{ hw }}" height="{{ hh }}"
       viewBox="0 0 1000 240" preserveAspectRatio="none">
    <path d="{{ spark_area_path }}" fill="url(#horizonFade)"/>
    <path d="{{ spark_path }}" fill="none" stroke="{{ p.accent }}"
          stroke-width="4" stroke-opacity="0.75" stroke-linejoin="round" stroke-linecap="round"
          vector-effect="non-scaling-stroke"/>
  </svg>
  {# the star floats beyond the last wave — the birth is the milestone
     after the final contraction, not the contraction itself #}
  {% set star_x = hx + hw + 42 %}
  {% set star_y = hy + spark_last_y / 240 * hh - 12 %}
  <path d="{{ sparkle(star_x, star_y, 22) }}" fill="{{ p.accent }}"/>
  {# no wave callouts here — this horizon is small and already captioned;
     the callouts live on the wide bands (mugs, reels) #}
  {% endif %}

  <text x="{{ w // 2 }}" y="1988" text-anchor="middle"
        font-family="{{ p.display_font }}" font-size="42" font-style="italic"
        fill="{{ p.ink }}" opacity="0.6">the rhythm of labor, wave by wave</text>
  <text x="{{ w // 2 }}" y="2044" text-anchor="middle" font-family="{{ p.body_font }}"
        font-size="28" letter-spacing="6" fill="{{ p.ink }}"
        opacity="0.45">{{ count }} CONTRACTIONS TIMED{% if labor_start_time %} · FIRST AT {{ labor_start_time|upper }}{% endif %}</text>
</svg>
