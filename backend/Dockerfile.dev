FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/usr/local

WORKDIR /app

# libpq5: psycopg2 runtime. libcairo2: cairosvg rasterization.
# fonts-montserrat (labels/numerals) + fonts-dejavu-core (fallback) +
# fontconfig: gift artwork. The display serif (Cormorant Garamond) is vendored
# in assets/fonts (SIL OFL) because Debian doesn't package it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpq5 libcairo2 fontconfig fonts-montserrat fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY assets/fonts/*.ttf /usr/local/share/fonts/cormorant/
RUN fc-cache -f

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project

EXPOSE 8000
